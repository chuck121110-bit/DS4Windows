<Window x:Class="DS4WinWPF.DS4Forms.OnScreenKeyboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="On-Screen Keyboard" Height="360" Width="860"
        WindowStyle="None" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False"
        ShowActivated="False" Background="#FFF5F7FA">
    <Border BorderBrush="#FFC8C8C8" BorderThickness="1" Padding="8" Background="#FFF5F7FA">
        <DockPanel>
            <TextBlock x:Name="statusText" DockPanel.Dock="Top" Margin="0,0,0,6" Foreground="Black"
                       Text="Use joystick / D-pad to move, X to click, Circle to close." TextWrapping="Wrap" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="keysPanel" Orientation="Vertical" HorizontalAlignment="Center" />
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
