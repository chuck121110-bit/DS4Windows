<Window x:Class="DS4WinWPF.DS4Forms.OnScreenKeyboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="On-Screen Keyboard" Height="400" Width="700"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        ShowActivated="False">
    <DockPanel Margin="8">
        <TextBlock x:Name="statusText" DockPanel.Dock="Top" Margin="0,0,0,6"
                   Text="Use joystick / D-pad to move, X to click, Circle to close." TextWrapping="Wrap" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="keysPanel" Orientation="Vertical" HorizontalAlignment="Center" />
        </ScrollViewer>
    </DockPanel>
</Window>
