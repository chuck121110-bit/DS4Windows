<Window x:Class="DS4WinWPF.DS4Forms.OnScreenKeyboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="On-Screen Keyboard" Height="480" Width="1120"
        WindowStyle="None" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False"
        ShowActivated="False" AllowsTransparency="True" Background="Transparent">
    <Border BorderBrush="Transparent" BorderThickness="0" Padding="0" Background="Transparent">
        <DockPanel Background="Transparent">
            <StackPanel x:Name="keysPanel" Orientation="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
        </DockPanel>
    </Border>
</Window>
